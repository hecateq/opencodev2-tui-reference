{
  "name": "opencodev2-tui-denemee",
  "version": "0.1.0",
  "description": "OpenCode v2 TUI Assistant & Status Widget Plugin",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx",
      "types": "./src/tui.tsx",
      "default": "./src/tui.tsx"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external @opencode-ai/* && bun build ./src/tui.tsx --outdir ./dist --target node --external @opencode-ai/* --external @opentui/* --external solid-js --external solid-js/*",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "beta",
    "@opencode-ai/theme": "beta",
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "beta",
    "@opencode-ai/theme": "beta",
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0"
  }
}
